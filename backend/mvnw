#!/usr/bin/env sh
set -eu

DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MAVEN_HOME="${MAVEN_HOME:-/Users/raphael/.maven/maven-3.10.0}"
MAVEN_BIN="${MAVEN_HOME}/bin/mvn"

if [ ! -x "$MAVEN_BIN" ]; then
  echo "Maven not found at $MAVEN_BIN. Install Maven first or set MAVEN_HOME." >&2
  exit 1
fi

exec "$MAVEN_BIN" "$@"
